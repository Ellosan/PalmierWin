{
  "name": "palmierwin",
  "version": "0.1.1",
  "description": "An independent Windows video editor inspired by Palmier's public workflow.",
  "private": true,
  "author": "PalmierWin contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/desktop/main.mjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "dist:win": "node scripts/build-windows.mjs",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.palmierwin.editor",
    "productName": "PalmierWin",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/ffmpeg.LICENSE",
      "!node_modules/ffmpeg-static/ffmpeg.README",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
    ],
    "asarUnpack": [
      "assets/demo/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "PalmierWin-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "PalmierWin-${version}-${arch}-Portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
